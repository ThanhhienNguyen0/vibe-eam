# Copy this file to .env before running Docker Compose. Values are local-development examples only.
POSTGRES_DB=eam
POSTGRES_USER=eam
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/sidebar
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
BACKEND_UPSTREAM=http://backend:4000
SEED_EXAMPLES=true

# For running the backend outside Docker, replace host "postgres" with "localhost".
DATABASE_URL=postgresql://eam:change-me-for-local-development@localhost:5432/eam?schema=public
STORAGE_BACKEND=database
JWT_SECRET=local-development-jwt-secret-change-before-sharing-12345
