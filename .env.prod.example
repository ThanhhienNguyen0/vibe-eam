# Production example only. Copy to .env.prod and replace every placeholder secret.
POSTGRES_DB=eam_prod
POSTGRES_USER=eam_prod
POSTGRES_PASSWORD=replace-with-a-unique-strong-production-password
DATABASE_URL=postgresql://eam_prod:replace-with-a-unique-strong-production-password@postgres:5432/eam_prod?schema=public

BACKEND_PORT=4401
FRONTEND_PORT=8080
CORS_ORIGIN=https://eam.messers-cardio-club.de
BACKEND_UPSTREAM=http://backend:4000
VITE_API_BASE_URL=/api/sidebar
STORAGE_BACKEND=database
SEED_EXAMPLES=false
