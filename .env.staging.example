# Staging example only. Copy to .env.staging and replace every placeholder secret.
POSTGRES_DB=eam_staging
POSTGRES_USER=eam_staging
POSTGRES_PASSWORD=replace-with-a-strong-staging-password
DATABASE_URL=postgresql://eam_staging:replace-with-a-strong-staging-password@postgres:5432/eam_staging?schema=public
JWT_SECRET=replace-with-a-unique-random-staging-jwt-secret-at-least-32-characters

BACKEND_PORT=4400
FRONTEND_PORT=8081
CORS_ORIGIN=https://eam-test.messers-cardio-club.com
BACKEND_UPSTREAM=http://backend:4000
VITE_API_BASE_URL=/api/sidebar
STORAGE_BACKEND=database
SEED_EXAMPLES=true
