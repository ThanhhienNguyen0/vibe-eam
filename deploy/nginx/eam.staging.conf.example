# Enable the HTTPS server block only after Certbot created the certificate.
server {
    listen 80;
    listen [::]:80;
    server_name eam-test.messers-cardio-club.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name eam-test.messers-cardio-club.com;

    # Recommended temporary protection until application authentication exists:
    # auth_basic "EAM Demo";
    # auth_basic_user_file /etc/nginx/.htpasswd-eam;

    ssl_certificate /etc/letsencrypt/live/eam-test.messers-cardio-club.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/eam-test.messers-cardio-club.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /api/ {
        proxy_pass http://127.0.0.1:4400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
